# Configuración local: contiene la app_key y credenciales de base de datos.
/config/config.php

# Informe interno de auditoría: incluye rutas locales y detalles de seguridad.
/INFORME-SEGURIDAD-QA.md

# Clave privada de firma de actualizaciones (solo para configurarla en GitHub).
/data/update-signing.key

# Caché de comprobación de actualizaciones y paquetes temporales.
/data/update-check.json
/data/tmp/

# Datos locales, copias de seguridad y adjuntos subidos.
/data/*.sqlite
/data/*.sqlite-*
/data/*.sqlite.bak-*
/data/backup-*
/data/php-error.log
/data/uploads/*
!/data/uploads/.gitkeep

# Paquetes generados.
/dist/

# Informes internos de auditoría, planes de corrección y notas de trabajo.
/INFORME-*.md
/Auditoria_*.html
/PLAN-CORRECCION-*.md

# Metadatos locales de herramientas y editores.
/.freebuff/
/.vscode/
/.idea/
